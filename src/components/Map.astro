---
import 'leaflet/dist/leaflet.css';
import { site } from '../data/site';

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.regionLong} ${site.address.zip}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---

<div
  class="map"
  data-map
  data-lat={site.geo.lat}
  data-lng={site.geo.lng}
  data-href={mapsUrl}
  role="region"
  aria-label={`Map showing ${site.name} at ${fullAddress}`}
>
</div>

<style>
  .map {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: var(--paper-2);
    /* Leaflet panes use z-index 400–1000; keep them contained so they never cover the fixed header */
    position: relative;
    z-index: 0;
    isolation: isolate;
  }

  /* Make the OSM tiles look like a faded photocopy of a printed map */
  .map :global(.leaflet-tile-pane) {
    filter: grayscale(1) sepia(0.35) contrast(1.15) brightness(1.02);
    mix-blend-mode: multiply;
  }

  /* Paper-and-marker controls */
  .map :global(.leaflet-control-zoom a) {
    background: var(--index);
    color: var(--ink);
    font-family: var(--marker);
    border-color: var(--ink);
  }
  .map :global(.leaflet-control-zoom a:hover) {
    background: var(--sticky);
    color: var(--ink);
  }
  .map :global(.leaflet-bar) {
    border: 2px solid var(--ink);
    border-radius: 3px;
    box-shadow: 3px 3px 0 var(--ink);
    overflow: hidden;
  }
  .map :global(.leaflet-control-attribution) {
    background: rgba(246, 240, 224, 0.85);
    color: var(--pencil);
    font-family: var(--type);
    font-size: 10px;
  }
  .map :global(.leaflet-control-attribution a) {
    color: var(--ballpoint);
  }

  /* Hand-drawn marker pin */
  .map :global(.pin) {
    filter: drop-shadow(2px 3px 1px rgba(0, 0, 0, 0.35));
    transition: transform 0.2s ease;
  }
  .map :global(.pin:hover) {
    transform: translateY(-3px) rotate(-4deg);
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-map]');

  async function init() {
    if (!el) return;
    const L = (await import('leaflet')).default;
    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);

    const map = L.map(el, {
      center: [lat, lng],
      zoom: 16,
      scrollWheelZoom: false,
      attributionControl: true,
    });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    const icon = L.divIcon({
      className: 'pin',
      iconSize: [36, 48],
      iconAnchor: [18, 46],
      html: `<svg viewBox="0 0 36 48" width="36" height="48" aria-hidden="true">
        <path d="M18.4 2.3C9.5 1.6 2.4 8.8 2.2 17.4 2 29.8 18 46 18 46s15.8-16.1 16-28.6C34.2 8.6 27 2.6 17.2 2.4" fill="#ff2d95" stroke="#1d1b19" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M18 9.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L18 23l-5.4 3 1.2-6-4.5-4.2 6.1-.7z" fill="#fff8e6" stroke="#1d1b19" stroke-width="1.6" stroke-linejoin="round"/>
      </svg>`,
    });

    L.marker([lat, lng], { icon, title: 'The Star Chamber', alt: 'The Star Chamber' })
      .addTo(map)
      .on('click', () => window.open(el.dataset.href, '_blank', 'noopener'));
  }

  if (el) {
    // Load Leaflet only when the map is about to scroll into view
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init();
        }
      },
      { rootMargin: '400px' },
    );
    io.observe(el);
  }
</script>
