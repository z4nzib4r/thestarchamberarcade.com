---
import 'leaflet/dist/leaflet.css';
import { site } from '../data/site';

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.regionLong} ${site.address.zip}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---

<div
  class="map"
  data-map
  data-lat={site.geo.lat}
  data-lng={site.geo.lng}
  data-href={mapsUrl}
  role="region"
  aria-label={`Map showing ${site.name} at ${fullAddress}`}
>
</div>

<style>
  .map {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: #0b0b0d;
    /* Leaflet panes use z-index 400–1000; keep them contained so they never cover the fixed header */
    position: relative;
    z-index: 0;
    isolation: isolate;
  }

  /* Turn the standard OSM tiles into a dark map (tiles only, so the pin keeps its color) */
  .map :global(.leaflet-tile-pane) {
    filter: invert(1) grayscale(1) brightness(0.85) contrast(0.95);
  }

  /* Dark UI chrome to match the site */
  .map :global(.leaflet-control-zoom a) {
    background: #000;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.15);
  }
  .map :global(.leaflet-control-zoom a:hover) {
    background: var(--pink);
    color: #000;
  }
  .map :global(.leaflet-bar) {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    overflow: hidden;
  }
  .map :global(.leaflet-control-attribution) {
    background: rgba(0, 0, 0, 0.7);
    color: rgba(255, 255, 255, 0.55);
    font-size: 10px;
  }
  .map :global(.leaflet-control-attribution a) {
    color: rgba(255, 255, 255, 0.8);
  }

  /* Pink neon pin */
  .map :global(.pin) {
    filter: drop-shadow(0 0 6px var(--pink)) drop-shadow(0 0 14px rgba(255, 45, 149, 0.6));
    transition: transform 0.2s ease;
  }
  .map :global(.pin:hover) {
    transform: translateY(-3px);
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-map]');

  async function init() {
    if (!el) return;
    const L = (await import('leaflet')).default;
    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);

    const map = L.map(el, {
      center: [lat, lng],
      zoom: 16,
      scrollWheelZoom: false,
      attributionControl: true,
    });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    const icon = L.divIcon({
      className: 'pin',
      iconSize: [36, 48],
      iconAnchor: [18, 46],
      html: `<svg viewBox="0 0 36 48" width="36" height="48" aria-hidden="true">
        <path d="M18 2C9.2 2 2 9 2 17.7 2 29.5 18 46 18 46s16-16.5 16-28.3C34 9 26.8 2 18 2z" fill="#ff2d95" stroke="#fff" stroke-width="2"/>
        <path d="M18 9.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L18 23l-5.4 3 1.2-6-4.5-4.2 6.1-.7z" fill="#000"/>
      </svg>`,
    });

    L.marker([lat, lng], { icon, title: 'The Star Chamber', alt: 'The Star Chamber' })
      .addTo(map)
      .on('click', () => window.open(el.dataset.href, '_blank', 'noopener'));
  }

  if (el) {
    // Load Leaflet only when the map is about to scroll into view
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init();
        }
      },
      { rootMargin: '400px' },
    );
    io.observe(el);
  }
</script>
