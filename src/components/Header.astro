---
import { site } from '../data/site';

const links = [
  { href: '#visit', label: 'Visit' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#games', label: 'Games' },
  { href: '#parties', label: 'Parties' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="header" data-header>
  <div class="strip" aria-hidden="true"></div>
  <div class="container bar">
    <a href="#top" class="brand" aria-label={`${site.name} home`}>
      <svg viewBox="0 0 64 64" aria-hidden="true" class="mark">
        <path
          d="M32 5.5c14.5-.4 27 11 26.6 26.8C58.3 47 46.5 59 31.4 58.6 16.8 58.2 5.2 46.4 5.6 31.6 6 17.5 17.6 6.4 33.5 6.8"
          fill="none"
          stroke="currentColor"
          stroke-width="3.4"
          stroke-linecap="round"></path>
        <path
          d="M32 14.5l5.2 11.4 12.4 1.3-9.4 8.2 2.9 12.4L32.3 41l-10.8 6.6 2.7-12.3-9.6-8.5 12.6-.8z"
          fill="var(--pink)"
          stroke="currentColor"
          stroke-width="3"
          stroke-linejoin="round"></path>
      </svg>
      <span>The Star Chamber</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul id="nav-menu" data-menu>
        {
          links.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <span class="status" data-status hidden>
      <span data-status-text></span>
    </span>

    <button class="menu-btn" aria-expanded="false" aria-controls="nav-menu" data-menu-btn>
      <span class="sr-only">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: transform 0.3s ease;
  }
  /* Kraft-paper strip with a torn bottom edge */
  .strip {
    position: absolute;
    inset: -12px -12px 0;
    background-color: var(--kraft);
    background-image: var(--grain), var(--fibers);
    background-blend-mode: multiply;
    filter: url(#torn) drop-shadow(0 4px 4px rgba(0, 0, 0, 0.35));
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .header.scrolled .strip {
    opacity: 1;
    transform: none;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--marker);
    font-size: 1.3rem;
    margin-right: auto;
    white-space: nowrap;
    color: var(--ink);
    transform: rotate(-1.5deg);
  }
  .mark {
    width: 38px;
    height: 38px;
    color: var(--ink);
    transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  }
  .brand:hover .mark {
    transform: rotate(-18deg) scale(1.08);
  }

  /* Label-maker tape links */
  .nav ul {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav li {
    --label: #1c1b1a;
    transform: rotate(calc((var(--i) - 2) * 0.9deg + (var(--i) * 37deg - 70deg) * 0.02));
  }
  .nav li:nth-child(3n + 2) {
    --label: #b3202a;
  }
  .nav li:nth-child(3n) {
    --label: #1d3b8a;
  }
  .nav a {
    display: block;
    padding: 0.28rem 0.75rem 0.22rem;
    font-family: var(--type);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.92);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.2), transparent 40%, rgba(0, 0, 0, 0.25)),
      var(--label);
    border-radius: 3px;
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.6), 0 1px 0 rgba(255, 255, 255, 0.18);
    box-shadow: 1px 2px 2px rgba(0, 0, 0, 0.35);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .nav a:hover {
    transform: translateY(-2px) rotate(-1deg);
    box-shadow: 2px 5px 5px rgba(0, 0, 0, 0.35);
  }
  .nav a:active {
    transform: translateY(1px);
    box-shadow: 0 0 1px rgba(0, 0, 0, 0.35);
  }

  /* Rubber stamp */
  .status {
    font-family: var(--worn);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem 0.1rem;
    color: var(--pencil);
    border: 3px double currentColor;
    border-radius: 6px;
    transform: rotate(-6deg);
    white-space: nowrap;
    mix-blend-mode: multiply;
    filter: url(#rough);
    font-weight: 700;
    text-shadow: 0 0 0.5px currentColor;
    -webkit-mask-image: var(--stamp-mask);
    mask-image: var(--stamp-mask);
  }
  .status.open {
    color: var(--red-pen);
    animation: stamp 0.45s cubic-bezier(0.2, 0.8, 0.3, 1.4) both;
  }
  @keyframes stamp {
    from {
      transform: rotate(-14deg) scale(1.8);
      opacity: 0;
    }
  }

  .menu-btn {
    display: none;
    width: 48px;
    height: 44px;
    border: 2.5px solid var(--ink);
    border-radius: 4px 8px 5px 9px;
    background: var(--index);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
    cursor: pointer;
    place-items: center;
    transform: rotate(2deg);
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .menu-btn:active {
    transform: rotate(2deg) translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 3px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s;
    position: relative;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger::before {
    top: -7px;
    width: 17px;
  }
  .burger::after {
    top: 7px;
    width: 22px;
  }
  .menu-btn[aria-expanded='true'] .burger {
    background: transparent;
  }
  .menu-btn[aria-expanded='true'] .burger::before {
    width: 20px;
    transform: translateY(7px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .burger::after {
    width: 20px;
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .bar {
      gap: 0.75rem;
    }
    .menu-btn {
      display: grid;
    }
    /* Menu drops down as an index card */
    .nav ul {
      position: fixed;
      top: 84px;
      right: var(--gutter);
      width: min(320px, calc(100vw - 2 * var(--gutter)));
      flex-direction: column;
      gap: 0;
      padding: 2.4rem 1.25rem 1.25rem;
      background-color: var(--index);
      background-image:
        var(--grain),
        linear-gradient(180deg, transparent 0 34px, rgba(214, 64, 64, 0.6) 34px 36px, transparent 36px),
        repeating-linear-gradient(180deg, transparent 0 51px, var(--rule) 51px 52px);
      background-blend-mode: multiply, normal, normal;
      box-shadow: var(--shadow-lift);
      transform: translateY(-16px) rotate(4deg);
      transform-origin: top right;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.3);
    }
    .nav ul::before {
      content: '';
      position: absolute;
      top: -12px;
      left: 50%;
      width: 96px;
      height: 28px;
      margin-left: -48px;
      background: var(--tape);
      transform: rotate(-3deg);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }
    .nav ul.open {
      opacity: 1;
      transform: rotate(-1.5deg);
      pointer-events: auto;
    }
    .nav li {
      transform: none;
    }
    .nav a {
      background: none;
      box-shadow: none;
      text-shadow: none;
      color: var(--ballpoint);
      font-family: var(--hand);
      font-weight: 600;
      font-size: 2rem;
      letter-spacing: 0;
      text-transform: none;
      line-height: 52px;
      padding: 0 0.25rem;
    }
    .nav a::before {
      content: '→ ';
      opacity: 0;
      transition: opacity 0.15s;
    }
    .nav a:hover {
      transform: none;
      box-shadow: none;
      color: var(--pink-ink);
    }
    .nav a:hover::before {
      opacity: 1;
    }
  }
  @media (max-width: 420px) {
    .brand span {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('open', open);
    if (open) header.classList.add('scrolled');
    else onScroll();
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
