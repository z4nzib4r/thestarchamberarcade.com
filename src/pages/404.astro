---
import Base from '../layouts/Base.astro';
---

<Base title="Game Over | The Star Chamber Arcade">
  <main class="wrap">
    <div class="sheet paper">
      <span class="tape top" style="--w:120px;--r:-4deg"></span>
      <p class="eyebrow">Error 404</p>
      <h1>GAME<br /><span>OVER</span></h1>
      <p class="sub">That page doesn’t exist. Press start to head back.</p>
      <a class="btn btn-pink" href={import.meta.env.BASE_URL}>Continue? ▶</a>
      <span class="doodle" aria-hidden="true">x_x</span>
    </div>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--gutter);
  }
  .sheet {
    --margin-x: 48px;
    position: relative;
    width: min(100%, 560px);
    padding: 3.5rem 2rem 3rem calc(var(--margin-x) + 2rem);
    text-align: left;
    transform: rotate(-2deg);
    /* crumpled: uneven light across creases */
    box-shadow:
      inset 40px -30px 60px -40px rgba(0, 0, 0, 0.12),
      inset -50px 40px 70px -50px rgba(0, 0, 0, 0.14),
      var(--shadow-lift);
  }
  .sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(118deg, transparent 38%, rgba(0, 0, 0, 0.06) 39%, transparent 41%),
      linear-gradient(62deg, transparent 58%, rgba(255, 255, 255, 0.5) 59%, transparent 61%),
      linear-gradient(-20deg, transparent 70%, rgba(0, 0, 0, 0.05) 71%, transparent 73%);
  }
  h1 {
    font-family: var(--marker);
    font-weight: 400;
    font-size: clamp(3.5rem, 14vw, 6rem);
    line-height: 0.95;
    margin: 0 0 1.25rem;
    transform: rotate(-3deg);
  }
  h1 span {
    color: var(--red-pen);
  }
  .sub {
    margin: 0 0 2rem;
  }
  .doodle {
    position: absolute;
    right: 2rem;
    top: 2.5rem;
    font-family: var(--hand);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--ballpoint);
    transform: rotate(12deg);
  }
</style>
