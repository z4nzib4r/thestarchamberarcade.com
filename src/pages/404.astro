---
import Base from '../layouts/Base.astro';
---

<Base title="Game Over | The Star Chamber Arcade">
  <main class="wrap">
    <p class="eyebrow">Error 404</p>
    <h1>GAME<br /><span>OVER</span></h1>
    <p class="sub">That page doesn’t exist. Press start to head back.</p>
    <a class="btn btn-pink" href="/">Continue? ▶</a>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: var(--gutter);
  }
  h1 {
    font-family: var(--pixel);
    font-size: clamp(2.5rem, 10vw, 5rem);
    line-height: 1.2;
    margin: 0 0 1.5rem;
  }
  h1 span {
    color: var(--pink);
    text-shadow: 0 0 30px var(--pink-glow);
  }
  .sub {
    color: var(--muted);
    margin: 0 0 2rem;
  }
</style>
